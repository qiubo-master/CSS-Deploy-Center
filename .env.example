GITHUB_TOKEN=github_fine_grained_token
CONTROL_CENTER_ADMIN_TOKEN=replace_with_a_long_random_value

# 多项目部署目标
CSS_GITHUB_REPOSITORY=qiubo-master/CSS
CSS_GITHUB_WORKFLOW_FILE=deploy.yml
CSS_HEALTH_URL=https://css.example.com/api/v1/health
CSS_PUBLIC_URL=https://css.example.com

MEDIA_GITHUB_REPOSITORY=qiubo-master/Media
MEDIA_GITHUB_WORKFLOW_FILE=deploy.yml
MEDIA_HEALTH_URL=http://your-server-ip:8080
MEDIA_PUBLIC_URL=http://your-server-ip:8080

# 服务器资产与监控代理。未配置监控地址时，控制台会明确显示“监控待接入”。
ALIYUN_REGION=cn-hangzhou
ALIYUN_MONITOR_URL=https://monitor.example.com/v1/resources
MONITOR_AGENT_TOKEN=replace_with_a_read_only_monitor_token

# 可选：用 JSON 扩展阿里云、其他云厂商或 AutoDL 目标。
# SERVER_INVENTORY_JSON=[{"id":"autodl-gpu-1","name":"AutoDL GPU 01","provider":"AutoDL","kind":"autodl","region":"西北","address":"实例地址","monitorUrl":"https://agent.example.com/v1/resources","projectIds":["media"]}]
