GITHUB_TOKEN=github_fine_grained_token
CONTROL_CENTER_ADMIN_TOKEN=replace_with_a_long_random_value
# 用于 AES-256-GCM 加密保存服务器密码或私钥。生产环境请使用至少 32 位随机值。
SERVER_CREDENTIAL_KEY=replace_with_a_different_long_random_value

# 多项目部署目标
CSS_GITHUB_REPOSITORY=qiubo-master/CSS
CSS_GITHUB_WORKFLOW_FILE=deploy.yml
CSS_HEALTH_URL=https://css.example.com/api/v1/health
CSS_PUBLIC_URL=https://css.example.com

MEDIA_GITHUB_REPOSITORY=qiubo-master/Media
MEDIA_GITHUB_WORKFLOW_FILE=deploy.yml
MEDIA_HEALTH_URL=http://your-server-ip:8080
MEDIA_PUBLIC_URL=http://your-server-ip:8080

OTEL_GITHUB_REPOSITORY=qiubo-master/Otel
OTEL_GITHUB_WORKFLOW_FILE=deploy.yml
OTEL_HEALTH_URL=http://your-server-ip:13133
OTEL_PUBLIC_URL=http://your-server-ip:3000

WORD_GAME_GITHUB_REPOSITORY=qiubo-master/WordGame
WORD_GAME_GITHUB_WORKFLOW_FILE=cloudbase.yml
WORD_GAME_HEALTH_URL=https://wordgame-1-d7gx6qvym115a8f41-1348325609.ap-shanghai.app.tcloudbase.com/wqapi/api/health
WORD_GAME_PUBLIC_URL=https://wordgame-1-d7gx6qvym115a8f41.tcloudbase.com

GFM_GITHUB_REPOSITORY=qiubo-master/GFM
GFM_GITHUB_WORKFLOW_FILE=deploy.yml
GFM_HEALTH_URL=https://uu800904-ada3-4b719cf9.westb.seetacloud.com:8443/foundation/v1/health
GFM_PUBLIC_URL=https://uu800904-ada3-4b719cf9.westb.seetacloud.com:8443/
# 服务器资产与监控代理。未配置监控地址时，控制台会明确显示“监控待接入”。
PRIMARY_SERVER_ADDRESS=100.103.132.88
ALIYUN_REGION=cn-hangzhou
ALIYUN_MONITOR_URL=https://monitor.example.com/v1/resources
MONITOR_AGENT_TOKEN=replace_with_a_read_only_monitor_token

# 可选：用 JSON 扩展阿里云、其他云厂商或 AutoDL 目标。
# SERVER_INVENTORY_JSON=[{"id":"gpu-worker","name":"GPU 计算服务器","provider":"云服务商","kind":"cloud","region":"区域","address":"实例地址","monitorUrl":"https://agent.example.com/v1/resources","projectIds":["media"]}]
