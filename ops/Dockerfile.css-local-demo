FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    LLM_MODE=mock \
    DEMO_DATA_DIR=/app/data

WORKDIR /app
COPY . .
RUN python -m pip install --no-cache-dir \
      'fastapi>=0.116,<1' \
      'uvicorn[standard]>=0.35,<1' \
      'langgraph>=0.6,<2' \
      'httpx>=0.28,<1' \
      'pydantic>=2.11,<3' \
      'python-dotenv>=1.1,<2'

EXPOSE 8000
CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
